{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "plugin-jsx",
    "paths": {
      "plugin-jsx/jsx-runtime": [
        "./src/jsx/jsx-runtime.ts"
      ],
      "plugin-jsx/jsx-dev-runtime": [
        "./src/jsx/jsx-dev-runtime.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
